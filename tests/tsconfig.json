{
  // Type-checks the root tests/ folder, which no package tsconfig covers. Vitest bundles the
  // tests itself, so use its resolution (ESM, extensionless imports) instead of Node16/CommonJS:
  // under Node16 the root package (no "type": "module") makes these files CommonJS, and importing
  // the ESM store adapter fails with TS1479. Checked by `npm run typecheck`.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Same targets as the Vitest alias (DIS-23 design D6): tests type-check against the sources.
    "paths": {
      "@codemind/core": ["../packages/core/src/index.ts"],
      "@codemind/adapter-git": ["../packages/adapters/git/src/index.ts"],
      "@codemind/adapter-llm": ["../packages/adapters/llm/src/index.ts"],
      "@codemind/adapter-store-postgres": ["../packages/adapters/store-postgres/src/index.ts"],
      "@codemind/analyzer-php": ["../packages/analyzers/php/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
