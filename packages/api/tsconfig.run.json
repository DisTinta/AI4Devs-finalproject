{
  // Used only by the API's `dev` script and the start-up process test (tsx): resolves every workspace
  // package the API imports to its sources, so running the API never depends on a built — possibly
  // stale or missing — `dist/` (DIS-76 design U6, as the CLI's DIS-86 design D10). Not referenced by
  // the root tsconfig, so `tsc --build` ignores it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@codemind/core": ["../core/src/index.ts"],
      "@codemind/adapter-git": ["../adapters/git/src/index.ts"],
      "@codemind/adapter-llm": ["../adapters/llm/src/index.ts"],
      "@codemind/adapter-store-postgres": ["../adapters/store-postgres/src/index.ts"]
    }
  }
}
