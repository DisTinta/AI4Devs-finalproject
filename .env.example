# CODEMIND — variables de entorno
# Copia este fichero a .env y ajusta los valores locales.
# .env nunca se versiona (.gitignore). Este fichero sí.

# ── LLM (todos opcionales) ──────────────────────────────────────────────────
# LLM_BASE_URL decide el modo:
#   - LLM_BASE_URL y LLM_API_KEY vacías → modo evaluación (solo caché/golden, 0 €, sin cuenta).
#   - LLM_BASE_URL definida → modo vivo; LLM_API_KEY es opcional (Ollama no necesita clave).
#   - LLM_API_KEY sin LLM_BASE_URL → error al arrancar.
# Con otro proveedor compatible OpenAI: ajusta BASE_URL, API_KEY y MODEL.
# No se asume ningún vendor de pago como obligatorio.

LLM_BASE_URL=
# Base URL compatible OpenAI (http o https).
# Ejemplo de desarrollo con Ollama: http://localhost:11434/v1

LLM_API_KEY=
# Credencial del endpoint LLM; si está, se envía como "Authorization: Bearer …".
# Con Ollama se deja vacía.

LLM_MODEL=
# Modelo para generación de respuestas. Obligatorio si LLM_BASE_URL está definida.
# Ejemplo Ollama: llama3.2, mistral, qwen2.5-coder...
# Lo elige quien configure el endpoint; sin vendor fijo.

LLM_MODEL_VERIFY=
# Modelo económico para verificación de evidencias en vivo.
# Vacío = se usa LLM_MODEL. Irrelevante en modo evaluación.

LLM_EMBED_MODEL=
# Modelo de embeddings. Vacío = embeddings no disponibles (nunca se usa LLM_MODEL).
# Sus vectores deben tener 1536 dimensiones (vector(1536) del esquema): con
# nomic-embed-text (768) todas las llamadas fallan con dimension-mismatch hasta DIS-46.

# LLM_TIMEOUT_MS=120000
# Tiempo máximo por petición al LLM, en ms (entero de 1 a 2147483647).
# Por defecto 120000, para el arranque en frío de Ollama al cargar el modelo.

# Ejemplo completo con Ollama local (sin clave):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2
# LLM_EMBED_MODEL=nomic-embed-text

# ── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://codemind:codemind@localhost:5432/codemind
# Cadena de conexión. Por defecto apunta al contenedor local del compose.

POSTGRES_USER=codemind
POSTGRES_PASSWORD=codemind
POSTGRES_DB=codemind

# ── Seguridad ───────────────────────────────────────────────────────────────
ALLOWED_REPOS_DIR=
  # Directorio raíz permitido para indexar repositorios propios.
  # Sin valor = indexado deshabilitado (modo solo-fixtures).
  # Solo debe poder escribir en él el usuario que ejecuta Codemind, y solo debe
  # contener repositorios de confianza: quien pueda escribir dentro podría hacer
  # que git lea objetos de fuera (ver docs/DEPLOYMENT.md).

# ── Presupuesto ─────────────────────────────────────────────────────────────
DAILY_BUDGET_USD=
# Techo de gasto diario si se usa proveedor cloud de pago.
# Irrelevante con Ollama local (coste 0 €).
# Al alcanzarlo el sistema degrada a modo solo-caché con aviso.

# ── Historial de Git ────────────────────────────────────────────────────────
# Obligatoria. Sal (clave del HMAC) con la que se seudonimiza el autor de cada
# commit: en la base de datos solo se guarda author_hash, nunca nombre ni correo.
# No subas nunca un valor al repositorio. Si la cambias, cambian todos los
# author_hash guardados.
AUTHOR_HASH_SALT=
