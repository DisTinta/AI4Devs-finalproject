# task-api — sample environment. Copy to .env and adjust.
# No real secrets here on purpose: the planted fixture secret lives in source
# (see src/config/env.ts) so the secret scanner has something to redact.
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
# Signing secret is read from env in real deployments; empty here falls back to
# the (clearly fake) development default.
JWT_SECRET=
