APP_NAME=acme-shop
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# APP_KEY is generated with `php artisan key:generate`. Left blank on purpose:
# the planted fixture secret lives in config/app.php so the scanner has one
# obviously-fake credential to detect.
APP_KEY=

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
