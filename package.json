{
  "name": "codemind",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/core",
    "packages/analyzers/php",
    "packages/analyzers/typescript",
    "packages/adapters/store-postgres",
    "packages/adapters/llm",
    "packages/adapters/git",
    "packages/api",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm -w packages/api run dev\" \"npm -w packages/web run dev\"",
    "typecheck": "tsc --build && tsc -p packages/web/tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:architecture": "depcruise packages --config .dependency-cruiser.cjs",
    "db:migrate": "tsx packages/adapters/store-postgres/src/migrate.ts up",
    "db:rollback": "tsx packages/adapters/store-postgres/src/migrate.ts down",
    "db:seed": "tsx --tsconfig packages/cli/tsconfig.run.json packages/cli/src/seed-load.ts",
    "cache:build": "tsx --tsconfig packages/cli/tsconfig.run.json packages/cli/src/cache-build.ts",
    "seed:build": "tsx --tsconfig packages/cli/tsconfig.run.json packages/cli/src/seed-build.ts",
    "cli": "tsx --tsconfig packages/cli/tsconfig.run.json packages/cli/src/index.ts",
    "verify": "tsx --tsconfig packages/cli/tsconfig.run.json packages/cli/src/verify.ts",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "docs:coverage": "typedoc --validation.notDocumented --logLevel Warn"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.0",
    "dependency-cruiser": "^16.3.0",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "pg": "^8.23.0",
    "tsx": "^4.16.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^1.6.0"
  }
}
