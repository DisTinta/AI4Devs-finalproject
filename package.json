{
  "name": "codemind",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/core",
    "packages/analyzers/php",
    "packages/analyzers/typescript",
    "packages/adapters/store-postgres",
    "packages/adapters/llm",
    "packages/adapters/git",
    "packages/api",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm -w packages/api run dev\" \"npm -w packages/web run dev\"",
    "up": "node scripts/up.mjs",
    "down": "docker compose down",
    "typecheck": "tsc --build && tsc -p packages/web/tsconfig.json --noEmit && tsc -p tests/tsconfig.json && tsc -p tests/a11y/tsconfig.json",
    "lint": "eslint .",
    "lint:architecture": "depcruise packages --config .dependency-cruiser.cjs",
    "db:migrate": "tsx --import=./scripts/load-env.mjs packages/adapters/store-postgres/src/migrate.ts up",
    "db:rollback": "tsx --import=./scripts/load-env.mjs packages/adapters/store-postgres/src/migrate.ts down",
    "db:seed": "tsx --import=./scripts/load-env.mjs --tsconfig packages/cli/tsconfig.run.json packages/cli/src/seed-load.ts",
    "cache:build": "tsx --import=./scripts/load-env.mjs --tsconfig packages/cli/tsconfig.run.json packages/cli/src/cache-build.ts",
    "seed:build": "tsx --import=./scripts/load-env.mjs --tsconfig packages/cli/tsconfig.run.json packages/cli/src/seed-build.ts",
    "cli": "tsx --import=./scripts/load-env.mjs --tsconfig packages/cli/tsconfig.run.json packages/cli/src/index.ts",
    "verify": "tsx --import=./scripts/load-env.mjs --tsconfig packages/cli/tsconfig.run.json packages/cli/src/verify.ts",
    "demo:ask": "node scripts/demo-ask.mjs",
    "demo:excerpt": "node scripts/demo-excerpt.mjs",
    "test": "vitest run",
    "test:a11y": "vitest run tests/a11y",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "docs:coverage": "typedoc --validation.notDocumented --logLevel Warn"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "concurrently": "^8.2.0",
    "dependency-cruiser": "^16.3.0",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "pg": "^8.23.0",
    "tsx": "^4.16.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
