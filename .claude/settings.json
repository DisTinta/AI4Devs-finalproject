{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.json)",
      "Read(**/credentials.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/service-account*.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh"
            ],
            "timeout": 20,
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secrets.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-reads.sh"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous-bash.sh"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-specs-and-tests.sh"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-gate.sh"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-quality.sh"
            ],
            "timeout": 180,
            "statusMessage": "Formatting and static analysis..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-tasks.sh"
            ],
            "timeout": 20,
            "statusMessage": "Validating tasks.md..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/invoke.cjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-tests.sh"
            ],
            "timeout": 600,
            "statusMessage": "Running the test suite..."
          }
        ]
      }
    ]
  }
}
