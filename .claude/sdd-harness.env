# SDD Harness Kit adapter — Fastify (TypeScript + Zod + Vitest, hexagonal monorepo)
#
# Assumes the layout of a monorepo with npm workspaces and hexagonal
# architecture: the domain in packages/core, the adapters outside, and the HTTP layer
# as just another adapter. If your project is a single-package Fastify,
# adjust PATH_* and the guards: the commands work the same.
STACK="fastify"

CMD_TEST="npx vitest run"
CMD_TEST_FILTER="npx vitest run"
CMD_LINT="npm run lint"
CMD_FORMAT_FILE="npx eslint --fix"
CMD_STATIC_FILE=""
CMD_STATIC="npm run typecheck"
CMD_MUTATION="npx stryker run"
CMD_DOCS_COVERAGE="npm run docs:coverage"
CMD_DEV="npm run dev"
CMD_MIGRATE="npm run db:migrate"

SOURCE_EXTENSIONS="ts tsx"
PATH_SOURCE="packages"
PATH_TESTS="tests"
PATH_BUSINESS="packages/core"
PATH_HTTP="packages/api"
PATH_MIGRATIONS="packages/adapters/store-postgres/migrations"
PATH_ADR="docs/adr"

# The domain knows neither the transport NOR the infrastructure. The second half of
# this expression is the monorepo's dependency rule: if the name of an
# infrastructure package appears in a packages/core file, the hook
# warns. It is the same rule that dependency-cruiser checks in CI, applied
# earlier, at the moment the file is written.
GUARD_HTTP_IN_BUSINESS="fastify|FastifyRequest|FastifyReply|node:http|(adapters|analyzers|store-postgres)/"
# The HTTP layer validates, delegates and serializes. It does not query the database.
GUARD_DB_IN_HTTP="new[[:space:]]+Pool|\.query\(|SELECT[[:space:]]|INSERT[[:space:]]+INTO|UPDATE[[:space:]]+[a-z_]+[[:space:]]+SET"
# Destroying the indexed graph costs a full reindex: it is not reversible from cold.
GUARD_DANGEROUS_CMD="npm[[:space:]]+run[[:space:]]+db:(reset|drop|wipe)|docker[[:space:]]+compose[[:space:]]+down[[:space:]]+.*-v|DROP[[:space:]]+(DATABASE|TABLE|SCHEMA)"

LAYER_ORDER="test → port (core/ports) → domain (core) → adapter → Zod schema (api) → route (api)"
MIN_MUTATION_SCORE="70"
BRANCH_PREFIX="feature/"
KIT_SKIP_STOP_TESTS="0"
KIT_ALLOW_WIP="0"
